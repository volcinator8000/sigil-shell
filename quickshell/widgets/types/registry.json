      {
        "key": "days",
        "label": "Days shown (when wide or tall)",
        "kind": "int",
        "min": 0,
        "max": 7,
        "step": 1,
        "default": 7
      },
      {
        "key": "showRange",
        "label": "Show high / low",
        "kind": "bool",
        "default": true
