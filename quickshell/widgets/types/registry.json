[
  {
    "type": "calendar",
    "label": "Calendar",
    "description": "Month grid or agenda with events from Google Calendar (or any iCal feed). Click a day for its events; ‹ › change month (agenda: week)",
    "options": [
      {
        "key": "view",
        "label": "View",
        "kind": "enum",
        "choices": [
          "month",
          "agenda"
        ],
        "default": "month"
      },
      {
        "key": "weekStart",
        "label": "Week starts on",
        "kind": "enum",
        "choices": [
          "monday",
          "sunday"
        ],
        "default": "monday"
      },
      {
        "key": "showWeek",
        "label": "Show week number",
        "kind": "bool",
        "default": true
      },
      {
        "key": "ics",
        "label": "Calendar feed (Google: Settings → your calendar → Secret address in iCal format; several = space separated)",
        "kind": "string",
        "default": ""
      },
      {
        "key": "events",
        "label": "Events listed (at least; a taller widget fits more)",
        "kind": "int",
        "min": 0,
        "max": 12,
        "step": 1,
        "default": 4
      },
      {
        "key": "agendaDays",
        "label": "Agenda: days ahead",
        "kind": "int",
        "min": 1,
        "max": 31,
        "step": 1,
        "default": 7
      }
    ]
  },
  {
    "type": "weather",
