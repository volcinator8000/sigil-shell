[
  {
    "type": "calendar",
    "label": "Calendar",
    "description": "Month grid with events from Google Calendar (or any iCal feed). Click a day for its events; \u2039 \u203a change month",
    "options": [
      {
        "key": "weekStart",
        "label": "Week starts on",
        "kind": "enum",
        "choices": [
          "monday",
          "sunday"
        ],
        "default": "monday"
      },
      {
        "key": "showWeek",
        "label": "Show week number",
        "kind": "bool",
        "default": true
      },
      {
        "key": "ics",
        "label": "Calendar feed (Google: Settings \u2192 your calendar \u2192 Secret address in iCal format; several = space separated)",
        "kind": "string",
        "default": ""
      },
      {
        "key": "events",
        "label": "Events listed",
        "kind": "int",
        "min": 0,
        "max": 12,
        "step": 1,
        "default": 4
      }
    ]
  },
  {
    "type": "weather",
    "label": "Weather",
    "description": "Current conditions from Open-Meteo (location: Shell page). Drag it wider or taller for the week",
    "options": [
      {
        "key": "showForecast",
        "label": "Show next hours",
        "kind": "bool",
        "default": true
      },
      {
        "key": "showRange",
        "label": "Show high / low",
        "kind": "bool",
        "default": true
      }
    ]
  },
  {
    "type": "perf",
    "label": "Performance",
    "description": "CPU, RAM, GPU and temperature graphs, root disk usage. Wider = longer timeline",
    "options": [
      {
        "key": "cpu",
        "label": "CPU",
        "kind": "bool",
        "default": true
      },
      {
        "key": "ram",
        "label": "RAM",
        "kind": "bool",
        "default": true
      },
      {
        "key": "gpu",
        "label": "GPU",
        "kind": "bool",
        "default": true
      },
      {
        "key": "temp",
        "label": "Temperature",
        "kind": "bool",
        "default": true
      },
      {
        "key": "disk",
        "label": "Root disk usage",
        "kind": "bool",
        "default": true
      },
      {
        "key": "width",
        "label": "Width",
        "kind": "int",
        "min": 200,
        "max": 480,
        "step": 10,
        "default": 276
      }
    ]
  },
  {
    "type": "clock",
    "label": "Clock",
    "description": "Large time and date",
    "options": [
      {
        "key": "seconds",
        "label": "Show seconds",
        "kind": "bool",
        "default": false
      },
      {
        "key": "h12",
        "label": "12-hour clock",
        "kind": "bool",
        "default": false
      },
      {
        "key": "showDate",
        "label": "Show date",
        "kind": "bool",
        "default": true
      },
      {
        "key": "size",
        "label": "Size",
        "kind": "int",
        "min": 24,
        "max": 120,
        "step": 2,
        "default": 44
      }
    ]
  },
  {
    "type": "notes",
    "label": "Notes",
    "description": "First lines of a Markdown file; [x] items are struck through. Click to edit; drag its edges for more lines / longer lines",
    "options": [
      {
        "key": "path",
        "label": "File",
        "kind": "string",
        "default": "~/notes.md"
