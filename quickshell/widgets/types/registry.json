  {
    "type": "updates",
    "label": "Updates",
    "description": "Pending pacman and AUR updates, with upgrade and check buttons",
    "options": [
      {
        "key": "rows",
        "label": "Packages listed",
        "kind": "int",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 8
