pragma ComponentBehavior: Bound

// Drawing-tablet mapping written to ~/.config/hypr/tablet.lua. Detection needs
// the EVIOCGABS ioctl, which QML cannot issue, so it calls TabletPage.detect()
// from the GTK app's own module (one source of truth for the parsing).

import QtQuick
import QtQuick.Layouts
import qs.services
import qs.components
import qs.settings.controls
import qs.settings.lib

PageView {
    id: page
    property bool pageActive: false
    readonly property string all: "All monitors"
    property var tab: null
    property var mons: []
    property bool loading: false
    readonly property var outputs: [all].concat(mons.map(m => m.name))

    function refresh() {
        loading = true;
        Sh.run([Sh.home + "/.local/bin/sigil-tablet-detect"], o => {
            try { page.tab = JSON.parse(o.split("\n").pop() || "null"); } catch (e) { page.tab = null; }
            page.loading = false;
        }, 15);
        Sh.run(["hyprctl", "-j", "monitors"], o => {
            try { page.mons = JSON.parse(o || "[]").map(m => ({ name: m.name, w: m.width, h: m.height, tr: m.transform || 0 })); }
            catch (e) { page.mons = []; }
            Sh.sh('for o in input:tablet:output input:tablet:left_handed input:tablet:relative_input input:tablet:active_area_size; do hyprctl getoption "$o" | head -1; done', g => {
                const l = g.split("\n");
                const val = s => { const m = (s || "").match(/(int|float|bool|str|vec2):\s*(.+)/); return m ? m[2].trim() : ""; };
                const out = val(l[0]);
                outDrop.currentIndex = Math.max(0, page.outputs.indexOf(out));
                const truthy = s => s === "true" || (parseFloat(s) || 0) !== 0;
                lefty.checked = truthy(val(l[1]));
                rel.checked = truthy(val(l[2]));
                prop.checked = (l[3] || "").indexOf("[0, 0]") < 0;
            });
        });
    }
    Component.onCompleted: refresh()

    function selectedOutput() { return outputs[outDrop.currentIndex] || all; }
    // Largest centred sub-rectangle of the surface with the screen's aspect.
    function cropFor(out) {
        if (!(tab && mons.length)) return null;
        const mon = mons.find(m => m.name === out) || mons[0];
        let w = mon.w, h = mon.h;
        if ([1, 3, 5, 7].indexOf(mon.tr) >= 0) { const t = w; w = h; h = t; }
        const aspect = w / h, tw = tab.w, th = tab.h;
        let cw, ch;
        if (tw / th > aspect) { cw = th * aspect; ch = th; } else { cw = tw; ch = tw / aspect; }
        return { cw: cw, ch: ch, cx: (tw - cw) / 2, cy: (th - ch) / 2, name: mon.name, aspect: aspect };
    }
    readonly property string propText: {
        if (!tab) return "no tablet detected";
        if (!prop.checked) return "off - the whole " + tab.w.toFixed(0) + " x " + tab.h.toFixed(0) + " mm surface is stretched to fill the screen";
        const c = cropFor(selectedOutput());
        if (!c) return "no monitor information";
        const dead = c.cy > 0.05 ? c.cy.toFixed(1) + " mm dead top and bottom" : c.cx > 0.05 ? c.cx.toFixed(1) + " mm dead left and right" : "no dead strip needed";
        return c.cw.toFixed(1) + " x " + c.ch.toFixed(1) + " mm active area for " + c.name + " (" + c.aspect.toFixed(2) + ":1) - " + dead;
    }

    function apply() {
        let out = selectedOutput();
        out = out === all ? "" : out;
        let L = ["-- generated by sigil-settings (Tablet page); loaded from hyprland.lua with pcall(dofile). Safe to delete."];
        if (tab) L.push("-- " + tab.name + " - " + tab.w.toFixed(1) + " x " + tab.h.toFixed(1) + " mm surface, " + (tab.pmax + 1) + " pressure levels");
        L = L.concat(["hl.config({ input = {", "    tablet = {",
                      '        output = "' + out + '",',
                      "        left_handed = " + (lefty.checked ? "true" : "false") + ",",
                      "        relative_input = " + (rel.checked ? "true" : "false") + ","]);
        // note: like the GTK app, an empty output ("All monitors") crops for the first monitor
        const c = prop.checked ? cropFor(out) : null;
        if (c) L = L.concat(["        -- proportions forced to " + c.name + " (" + c.aspect.toFixed(2) + ":1)",
                             "        active_area_size     = { " + c.cw.toFixed(1) + ", " + c.ch.toFixed(1) + " },",
                             "        active_area_position = { " + c.cx.toFixed(1) + ", " + c.cy.toFixed(1) + " },"]);
        else L = L.concat(["        -- { 0, 0 } is Hyprland's unset default: use the whole surface",
                           "        active_area_size     = { 0, 0 },",
                           "        active_area_position = { 0, 0 },"]);
        L = L.concat(["    },", "} })", ""]);
        Sh.writeFile(Sh.tabletLua, L.join("\n"), () => Sh.run(["hyprctl", "reload"], () => Sh.run(["hyprctl", "configerrors"], o => {
            Sh.toast(!o.trim() ? "Tablet settings applied" : "Hyprland reported a config error, see hyprctl configerrors");
            page.refresh();
        })));
    }
    function reset() {
        Sh.run(["rm", "-f", Sh.tabletLua], () => Sh.run(["hyprctl", "reload"], () => {
            Sh.toast("tablet.lua removed, mapping back to Hyprland defaults");
            page.refresh();
        }));
    }
    // helper scripts without trusting PATH (Hyprland's session PATH has no ~/.local/bin)
    readonly property string toolSh: 'for c in "$(command -v "$1")" "$HOME/.local/bin/$1" "$HOME/dotfiles-and-scripts/scripts/bin/$1"; do [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; exit; }; done'
    function jitter(args) {
        Sh.sh(toolSh, o => {
            if (!o) { Sh.toast("tablet-jitter not found"); return; }
            Sh.spawn(["kitty", "--title", "tablet-test", "-e", o].concat(args));
        }, 5, ["tablet-jitter"]);
    }
    function remapper() {
        Sh.sh('command -v input-remapper-gtk', o => {
            if (!o) { Sh.toast("input-remapper is not installed (paru -S input-remapper)"); return; }
            // opening the GUI with the tablet asleep has emptied the preset before
            if (!page.tab) { Sh.toast("Wake the tablet first - opening input-remapper without it can overwrite the preset with an empty one"); return; }
            Sh.spawn(["input-remapper-gtk"]);
        });
    }

    Section {
        title: "Device"
        SettingRow {
            glyph: "\u{F03FA}"
            glyphColor: page.tab ? Theme.a1 : Theme.dim
            title: page.loading && !page.tab ? "Looking for a tablet…" : page.tab ? page.tab.name : "No tablet detected"
            subtitle: page.tab
                ? page.tab.w.toFixed(0) + " x " + page.tab.h.toFixed(0) + " mm · " + (page.tab.pmax ? (page.tab.pmax + 1) + " pressure levels" : "no pressure")
                  + " · " + (({ "0005": "Bluetooth", "0003": "USB" })[page.tab.bus] || "bus " + page.tab.bus)
                : page.loading ? "" : "Wake it or reconnect it (Bluetooth page), then press Refresh"
            ActionButton { text: "Refresh"; onClicked: page.refresh() }
        }
    }

    Section {
        title: "Mapping"
        description: "Written to tablet.lua and applied with hyprctl reload."
        SettingRow {
            title: "Map to"; subtitle: "which screen the pen addresses"; enabled: !!page.tab
            Dropdown { id: outDrop; model: page.outputs }
        }
        SettingRow {
            title: "Force proportions"; subtitle: page.propText; enabled: !!page.tab
            Toggle { id: prop }
        }
        SettingRow { title: "Left-handed"; subtitle: "rotate the surface 180°"; enabled: !!page.tab; Toggle { id: lefty } }
        SettingRow { title: "Relative mode"; subtitle: "pen behaves like a mouse instead of mapping 1:1"; enabled: !!page.tab; Toggle { id: rel } }
        SettingRow {
            title: "Apply"; subtitle: "Write tablet.lua and reload Hyprland"
            ActionButton { text: "Apply"; accent: true; onClicked: page.apply() }
            ActionButton { text: "Reset"; danger: true; onClicked: page.reset() }
        }
    }

    Section {
        title: "Buttons"
        visible: !!page.tab && page.tab.keys > 0
        SettingRow {
            title: "ExpressKeys"
            subtitle: page.tab && page.tab.keys
                ? page.tab.keys + " key" + (page.tab.keys !== 1 ? "s" : "") + " on the pad, mapped to F15-F18 by input-remapper · in its GUI the pad lives under the *Pen* entry, because it groups both nodes under the shortest name"
                : "this tablet has no pad buttons"
            ActionButton { text: "Test"; onClicked: page.jitter(["buttons"]) }
            ActionButton { text: "Open input-remapper"; onClicked: page.remapper() }
        }
        SettingRow {
            title: "Pen barrel buttons"
            subtitle: "mapped to F13/F14 by input-remapper, so they work system-wide · bind those keys in Hyprland or in any app · unmapped they are just right/middle click"
        }
    }

    Section {
        title: "Diagnostics"
        SettingRow {
            title: "Jitter and report rate"; subtitle: "hold the pen still; measures noise in mm and Bluetooth stalls"
            ActionButton { text: "Run test"; onClicked: page.jitter([]) }
        }
    }
}
