pragma ComponentBehavior: Bound

// Keyboard / mouse / touchpad overrides written to ~/.config/hypr/local.lua
// (loaded with pcall, so a bad write can never take the session down).

import QtQuick
import QtQuick.Layouts
import qs.services
import qs.components
import qs.settings.controls
import qs.settings.lib

PageView {
    id: page
    property bool pageActive: false
    property var v: ({ repeat_rate: 25, repeat_delay: 600, sensitivity: 0, natural_scroll: true, tap_to_click: true,
                       disable_while_typing: true, clickfinger_behavior: false, scroll_factor: 1.0 })

    readonly property var opts: [["repeat_rate", "input:repeat_rate"], ["repeat_delay", "input:repeat_delay"], ["sensitivity", "input:sensitivity"],
        ["natural_scroll", "input:touchpad:natural_scroll"], ["tap_to_click", "input:touchpad:tap_to_click"],
        ["disable_while_typing", "input:touchpad:disable_while_typing"], ["clickfinger_behavior", "input:touchpad:clickfinger_behavior"],
        ["scroll_factor", "input:touchpad:scroll_factor"]]

    // `hyprctl getoption` first line → typed value (InputPage.opt in the GTK app)
    function parseOpt(out, def) {
        const m = (out.split("\n")[0] || "").match(/(int|float|bool|str):\s*(.+)/);
        if (!m) return def;
        const val = m[2].trim();
        if (typeof def === "boolean") return m[1] === "bool" ? val === "true" : parseFloat(val) !== 0;
        if (m[1] === "int" || m[1] === "float") return parseFloat(val);
        return val;
    }
    Component.onCompleted: load()
    function load() {
        Sh.sh('for o in "$@"; do hyprctl getoption "$o" | head -1; done', o => {
            const lines = o.split("\n");
            const d = Object.assign({}, page.v);
            page.opts.forEach((p, i) => d[p[0]] = page.parseOpt(lines[i] || "", d[p[0]]));
            page.v = d;
            natural.checked = d.natural_scroll; tap.checked = d.tap_to_click; dwt.checked = d.disable_while_typing; cf.checked = d.clickfinger_behavior;
        }, 8, opts.map(p => p[1]));
    }
    function b(x) { return x ? "true" : "false"; }
    function apply() {
        const lua = "-- generated by sigil-settings (Input page); loaded from hyprland.lua with pcall(dofile). Safe to delete.\n"
                  + "hl.config({ input = {\n"
                  + "    repeat_rate = " + Math.round(rate.value) + ", repeat_delay = " + Math.round(delay.value) + ",\n"
                  + "    sensitivity = " + sens.value.toFixed(2) + ",\n"
                  + "    touchpad = {\n"
                  + "        natural_scroll = " + b(natural.checked) + ", tap_to_click = " + b(tap.checked) + ",\n"
                  + "        disable_while_typing = " + b(dwt.checked) + ", clickfinger_behavior = " + b(cf.checked) + ",\n"
                  + "        scroll_factor = " + scroll.value.toFixed(2) + ",\n"
                  + "    },\n} })\n";
        Sh.writeFile(Sh.localLua, lua, () => Sh.run(["hyprctl", "reload"], () => Sh.run(["hyprctl", "configerrors"], o =>
            Sh.toast(!o.trim() ? "Input settings applied" : "Hyprland reported a config error, see hyprctl configerrors"))));
    }
    function reset() {
        Sh.run(["rm", "-f", Sh.localLua], () => Sh.run(["hyprctl", "reload"], () => {
            Sh.toast("local.lua removed, back to hyprland.lua defaults");
            page.load();
        }));
    }

    Section {
        title: "Keyboard"
        description: "Layout stays in hyprland.lua (fr / azerty)."
        SettingRow { title: "Repeat rate"; subtitle: "keys per second while held"
            SpinField { id: rate; from: 5; to: 80; stepSize: 1; value: page.v.repeat_rate } }
        SettingRow { title: "Repeat delay"; subtitle: "ms before repeat starts"
            SpinField { id: delay; from: 100; to: 1500; stepSize: 25; value: page.v.repeat_delay } }
    }
    Section {
        title: "Mouse"
        SettingRow { title: "Sensitivity"; subtitle: "libinput accel bias (-1 … 1)"
            Slider { id: sens; from: -1; to: 1; stepSize: 0.05; value: page.v.sensitivity; format: x => (x >= 0 ? "+" : "") + x.toFixed(2) } }
    }
    Section {
        title: "Touchpad"
        SettingRow { title: "Natural scrolling"; Toggle { id: natural } }
        SettingRow { title: "Tap to click"; Toggle { id: tap } }
        SettingRow { title: "Disable while typing"; Toggle { id: dwt } }
        SettingRow { title: "Clickfinger"; subtitle: "2 fingers = right click, 3 = middle (instead of button areas)"; Toggle { id: cf } }
        SettingRow { title: "Scroll speed"; subtitle: "touchpad scroll factor"
            Slider { id: scroll; from: 0.2; to: 3; stepSize: 0.1; value: page.v.scroll_factor; format: x => x.toFixed(1) + "x" } }
        SettingRow {
            title: "Apply"; subtitle: "Write local.lua and reload Hyprland"
            ActionButton { text: "Apply"; accent: true; onClicked: page.apply() }
            ActionButton { text: "Reset"; danger: true; onClicked: page.reset() }
        }
    }
}
