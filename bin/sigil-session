#!/usr/bin/env bash
# Started by Hyprland at login: hands the session to sigil-shell (a systemd user service,
# restarted automatically if it crashes; sigil-health checks on it every minute).
UNITS="$HOME/.local/bin/sigil-units"
"$UNITS" env      # services get Hyprland's environment (cursor, Qt/GTK, PATH)
exec "$UNITS" start
