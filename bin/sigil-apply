#!/usr/bin/env python3
"""Render sigil-shell colour templates.

Reads the resolved palette that the shell writes to ~/.config/sigil/palette.json
and renders every file in <repo>/templates/*.tmpl. Each template declares where
it goes and how to reload the app in its first lines:

    # target: ~/.config/kitty/sigil-colors.conf
    # reload: pkill -USR1 -x kitty

Placeholders: {{bg}} {{s1}} {{s2}} {{line}} {{fg}} {{dim}} {{a1}} {{a2}} {{ok}}
{{warn}} {{crit}} {{ansi0}}..{{ansi15}} {{label}} {{radius}} {{font}}, plus
{{bg_rgb}}-style variants that give "r, g, b" for apps that want that.

Header lines (target/reload/clear) are stripped from the output, so templates can be
any format (CSS, TOML, conf). `# clear: empty` makes --clear write an empty file
instead of deleting it (for files another config imports).

Generators (code, not templates) handle configs that must embed the user's own file:
  starship: ~/.config/starship.toml + a "sigil" palette → ~/.config/sigil/starship.toml
            (zsh points STARSHIP_CONFIG at it only while it exists)

`sigil-apply --clear` (or mode != sigil) deletes every generated file and reloads
the apps, which puts them back on their own config.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(os.path.realpath(__file__)).parent.parent
TEMPLATES = REPO / "templates"
CFG = Path.home() / ".config" / "sigil"


def mode() -> str:
    try:
        return (CFG / "mode").read_text().strip()
    except OSError:
        return "legacy"


def header(text: str, key: str) -> str | None:
    m = re.search(rf"^#\s*{key}:\s*(.+)$", text, re.M)
    return m.group(1).strip() if m else None


def rgb(hexstr: str) -> str:
    h = hexstr.lstrip("#")
    return ", ".join(str(int(h[i:i + 2], 16)) for i in (0, 2, 4))


def reload(cmd: str | None) -> None:
    if cmd:
        subprocess.run(["sh", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


HEADER = re.compile(r"^#\s*(target|reload|clear):.*\n", re.M)


def mix(a: str, b: str, t: float) -> str:
    x = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    y = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(p + (q - p) * t):02x}" for p, q in zip(x, y))


def gen_starship(palette: dict, clear: bool) -> None:
    out = CFG / "starship.toml"
    if clear:
        out.unlink(missing_ok=True)
        return
    src = Path.home() / ".config" / "starship.toml"
    try:
        text = src.read_text()
    except OSError:
        return
    p = palette
    ansi = p.get("ansi") or []
    colors = {
        "blue": p["a1"], "purple": p["a2"], "pink": ansi[6] if len(ansi) > 6 else p["a2"],
        "red": p["crit"], "green": p["ok"], "amber": p["warn"], "orange": mix(p["warn"], p["crit"], 0.5),
        "text": p["fg"], "muted": p["dim"], "line": mix(p["line"], p["dim"], 0.25),
    }
    text = re.sub(r'(?m)^palette\s*=.*$', 'palette = "sigil"', text) if re.search(r'(?m)^palette\s*=', text) \
        else 'palette = "sigil"\n' + text
    text = re.sub(r"(?ms)^\[palettes\.sigil\].*?(?=^\[|\Z)", "", text)
    block = "\n[palettes.sigil]  # generated by sigil-apply from \"%s\"\n" % p.get("label", "")
    block += "".join(f'{k:<7}= "{v}"\n' for k, v in colors.items())
    new = "# Generated by sigil-apply from ~/.config/starship.toml. Do not edit.\n" + text.rstrip() + "\n" + block
    if not out.exists() or out.read_text() != new:
        out.write_text(new)


def gtk_reload() -> None:
    # GTK re-reads gtk.css when the theme name changes; bounce it so running apps pick up the colours
    try:
        cur = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"],
                             capture_output=True, text=True, timeout=3).stdout.strip().strip("'") or "Adwaita"
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Default"], timeout=3)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", cur], timeout=3)
    except Exception:
        pass


def main() -> int:
    if "--gtk-reload" in sys.argv:
        gtk_reload()
        return 0
    clear = "--clear" in sys.argv or mode() != "sigil"
    palette = {}
    if not clear:
        try:
            palette = json.loads((CFG / "palette.json").read_text())
        except (OSError, ValueError) as e:
            print(f"sigil-apply: no usable palette.json ({e})", file=sys.stderr)
            return 1

    values = {k: str(v) for k, v in palette.items() if not isinstance(v, list)}
    for i, c in enumerate(palette.get("ansi", [])):
        values[f"ansi{i}"] = c
    for k, v in list(values.items()):
        if re.fullmatch(r"#[0-9a-fA-F]{6}", v):
            values[f"{k}_rgb"] = rgb(v)
            values[f"{k}_hex"] = v[1:]

    for tmpl in sorted(TEMPLATES.glob("*.tmpl")):
        text = tmpl.read_text()
        target = header(text, "target")
        if not target:
            continue
        out = Path(os.path.expanduser(target))
        if clear:
            if header(text, "clear") == "empty":
                if not out.exists() or out.read_text() != "":
                    out.parent.mkdir(parents=True, exist_ok=True)
                    out.write_text("")
                    reload(header(text, "reload"))
            elif out.exists():
                out.unlink()
                reload(header(text, "reload"))
            continue
        rendered = re.sub(r"\{\{(\w+)\}\}", lambda m: values.get(m.group(1), m.group(0)), HEADER.sub("", text))
        if out.exists() and out.read_text() == rendered:
            continue
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(rendered)
        reload(header(text, "reload"))

    gen_starship(palette, clear)
    return 0


if __name__ == "__main__":
    sys.exit(main())
