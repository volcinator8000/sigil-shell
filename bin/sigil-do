#!/usr/bin/env bash
# One entry point for keybinds, hypridle and scripts: forwards an action to sigil-shell.
#
#   sigil-do launcher|emoji|clipboard|controlcenter|power|lock|settings|overview|media|dashboard
#
# If the shell is not answering it is (re)started first. `lock` never leaves the machine
# open: if the shell's lock screen has not engaged within 2 s, hyprlock locks instead.

action="${1:?usage: sigil-do <action>}"
ipc() { timeout 3 qs -c sigil ipc call "$@"; }
up() { timeout 3 qs -c sigil ipc show >/dev/null 2>&1; }

if ! up; then
    systemctl --user reset-failed sigil-shell.service >/dev/null 2>&1
    systemctl --user start sigil-shell.service >/dev/null 2>&1
    for _ in $(seq 1 12); do up && break; sleep 0.25; done
fi

case "$action" in
    lock)
        ipc lock lock >/dev/null 2>&1
        for _ in 1 2 3 4; do sleep 0.5; [ "$(ipc lock isLocked 2>/dev/null)" = true ] && exit 0; done
        # emergency fallback (the wrapper also clears a hung hyprlock that would block locking)
        [ -x "$HOME/.config/hypr/scripts/lock.sh" ] && exec "$HOME/.config/hypr/scripts/lock.sh"
        exec hyprlock ;;
    *)  exec timeout 5 qs -c sigil ipc call shell run "$action" ;;
esac
