#!/usr/bin/env bash
# Switch between the old desktop (waybar + friends) and sigil-shell, live.
#
#   sigil-switch sigil      snapshot /home, then run sigil-shell instead of waybar
#   sigil-switch legacy     back to waybar, generated colour files removed
#   sigil-switch toggle     flip between the two (bound to SUPER+CTRL+SHIFT+B)
#   sigil-switch status     show the current mode and what is running
#   sigil-switch palette X  pick a palette (cybersigil wallpaper ashfall coldiron bruise static patina)
#   sigil-switch restart    restart whichever side is active
#   sigil-switch test-lock  show the sigil lock screen for 6 s (unlocks by itself)
set -euo pipefail

CFG="$HOME/.config/sigil"
MODE_FILE="$CFG/mode"
mkdir -p "$CFG"

mode() { cat "$MODE_FILE" 2>/dev/null || echo legacy; }

notify() { command -v notify-send >/dev/null && notify-send -a sigil-shell "sigil-shell" "$1" || true; echo "$1"; }

stop_sigil() { "$HOME/.local/bin/sigil-units" legacy || true; }
stop_waybar() { pkill -x waybar >/dev/null 2>&1 || true; }

# Daemons that sigil-shell replaces. Only one notification daemon / polkit agent
# can own the session at a time, so they are handed over in both directions.
stop_legacy_daemons() {
    stop_waybar
    systemctl --user stop swaync hyprpolkitagent >/dev/null 2>&1 || true
    pkill -x swaync >/dev/null 2>&1 || true
    pkill -x hyprpaper >/dev/null 2>&1 || true
}
start_legacy_daemons() {
    systemctl --user start swaync hyprpolkitagent >/dev/null 2>&1 || true
    pgrep -x hyprpaper >/dev/null || setsid -f hyprpaper >/dev/null 2>&1
    pgrep -x waybar >/dev/null || setsid -f waybar >/dev/null 2>&1
}

start_sigil() {
    stop_waybar
    systemctl --user stop hyprpolkitagent >/dev/null 2>&1 || true
    pkill -x hyprpaper >/dev/null 2>&1 || true
    "$HOME/.local/bin/sigil-units" sigil      # blocks swaync, (re)starts the sigil-shell service
}
# hyprpaper only draws still images. An animated/video wallpaper is swapped for its
# still frame while in legacy mode and restored when switching back to sigil.
WALL_SAVE="$CFG/wallpaper-animated"
HP="$HOME/.config/hypr/hyprpaper.conf"
wall_to_still() {
    python3 - "$HP" "$WALL_SAVE" <<'PY'
import hashlib, os, re, subprocess, sys
hp, save = sys.argv[1:]
try: t = open(hp).read()
except OSError: sys.exit()
m = re.search(r"^\s*path\s*=\s*(.+?)\s*$", t, re.M)
if not m: sys.exit()
p = m.group(1)
ext = p.rsplit(".", 1)[-1].lower()
moving = {"mp4","m4v","mkv","webm","mov","avi","wmv","flv","ogv","mpg","mpeg","ts","3gp","gif","apng","mng"}
if ext not in moving: sys.exit()
still = os.path.expanduser("~/.cache/sigil/stills/") + hashlib.md5(p.encode()).hexdigest() + ".jpg"
if not os.path.exists(still):
    os.makedirs(os.path.dirname(still), exist_ok=True)
    subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", p, "-frames:v", "1", "-q:v", "3", still])
if os.path.exists(still):
    open(save, "w").write(p)
    open(hp, "w").write(t.replace(m.group(1), still))
PY
}
wall_restore() {
    [ -s "$WALL_SAVE" ] || return 0
    p=$(cat "$WALL_SAVE"); rm -f "$WALL_SAVE"
    [ -f "$p" ] && python3 -c 'import re,sys;hp,p=sys.argv[1:];t=open(hp).read();open(hp,"w").write(re.sub(r"(?m)^(\s*path\s*=\s*).+$",lambda m:m.group(1)+p,t,1))' "$HP" "$p"
}

start_legacy() {
    stop_sigil
    "$HOME/.local/bin/sigil-apply" --clear || true
    wall_to_still
    start_legacy_daemons
}

to_sigil() {
    if command -v snapper >/dev/null; then
        snapper -c home create --cleanup-algorithm number -d "sigil-switch: before switching to sigil-shell" 2>/dev/null \
            && echo "snapshot of /home created" || echo "warning: could not create a /home snapshot" >&2
    fi
    echo sigil > "$MODE_FILE"
    wall_restore
    start_sigil
    notify "Switched to sigil-shell. SUPER+CTRL+SHIFT+B switches back."
}
to_legacy() {
    echo legacy > "$MODE_FILE"
    start_legacy
    notify "Switched back to the old setup (waybar)."
}

case "${1:-status}" in
    sigil|new)     to_sigil ;;
    legacy|old)    to_legacy ;;
    toggle)        [ "$(mode)" = sigil ] && to_legacy || to_sigil ;;
    restart)       [ "$(mode)" = sigil ] && start_sigil || { stop_waybar; start_legacy; } ;;
    test-lock)     qs -c sigil ipc call lock test ;;
    palette)
        name="${2:?usage: sigil-switch palette <name>}"
        python3 - "$CFG/settings.json" "$name" <<'EOF'
import json, sys
p, name = sys.argv[1], sys.argv[2]
try: s = json.load(open(p))
except Exception: s = {}
s["palette"] = name
json.dump(s, open(p, "w"), indent=2); open(p, "a").write("\n")
EOF
        echo "palette → $name" ;;
    status)
        echo "mode:   $(mode)"
        echo "waybar: $(pgrep -x waybar >/dev/null && echo running || echo stopped)"
        echo "sigil:  $(qs list -c sigil 2>/dev/null | grep -q 'Instance' && echo running || echo stopped) (service: $(systemctl --user is-active sigil-shell 2>/dev/null))"
        echo "health: $(systemctl --user is-active sigil-health.timer 2>/dev/null) · last: $(journalctl --user -u sigil-health -n 1 -o cat --no-pager 2>/dev/null | tail -1)"
        echo "palette: $(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("palette","?"))' "$CFG/settings.json" 2>/dev/null || echo '?')" ;;
    *) sed -n '2,10p' "$0"; exit 1 ;;
esac
